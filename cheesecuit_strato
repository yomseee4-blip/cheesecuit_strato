                            </span>
                        </div>
                        
                        <!-- Card Body -->
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="flex justify-between items-start gap-2 mb-2">
                                <h3 class="font-serif font-bold text-lg text-stone-900 leading-snug">${item.name}</h3>
                            </div>
                            <p class="text-xs text-stone-500 leading-relaxed mb-5 flex-1">
                                ${item.desc}
                            </p>
                            
                            <!-- Price & Action -->
                            <div class="pt-4 border-t border-stone-100 flex items-center justify-between gap-2">
                                <div>
                                    <span class="text-[11px] text-stone-400 block">Harga</span>
                                    <span class="font-bold text-lg text-amber-800">${formatRupiah(item.price)}</span>
                                </div>
                                
                                ${qty === 0 ? `
                                    <button onclick="updateQty('${item.id}', 1)" class="px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold text-xs flex items-center gap-1.5 transition-colors shadow-sm">
                                        <i class="fa-solid fa-plus"></i>
                                        <span>Tambah</span>
                                    </button>
                                ` : `
                                    <div class="flex items-center gap-2 bg-amber-100 p-1 rounded-xl">
                                        <button onclick="updateQty('${item.id}', -1)" class="w-7 h-7 rounded-lg bg-white text-amber-900 font-bold flex items-center justify-center hover:bg-amber-50">
                                            <i class="fa-solid fa-minus text-xs"></i>
                                        </button>
                                        <span class="font-bold text-sm text-amber-950 w-5 text-center">${qty}</span>
                                        <button onclick="updateQty('${item.id}', 1)" class="w-7 h-7 rounded-lg bg-amber-500 text-amber-950 font-bold flex items-center justify-center hover:bg-amber-600">
                                            <i class="fa-solid fa-plus text-xs"></i>
                                        </button>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Update Jumlah Item di Keranjang
        function updateQty(id, delta) {
            const current = cart[id] || 0;
            const next = current + delta;
            
            if (next <= 0) {
                delete cart[id];
            } else {
                cart[id] = next;
                if (delta > 0) {
                    const prod = products.find(p => p.id === id);
                    showToast(`${prod.name} ditambahkan`);
                }
            }
            
            renderMenu();
            updateCartUI();
        }

        // Update UI Keranjang & Floating Bar
        function updateCartUI() {
            let totalItems = 0;
            let totalPrice = 0;
            const cartItemsEl = document.getElementById('cart-items');
            const entries = Object.entries(cart);

            if (entries.length === 0) {
                cartItemsEl.innerHTML = `
                    <div class="text-center py-12">
                        <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto mb-3 text-2xl">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <p class="font-bold text-stone-800">Keranjang masih kosong</p>
                        <p class="text-xs text-stone-500 mt-1">Yuk pilih varian Cheesecuit Strato favoritmu!</p>
                    </div>
                `;
            } else {
                cartItemsEl.innerHTML = entries.map(([id, qty]) => {
                    const item = products.find(p => p.id === id);
                    const subtotal = item.price * qty;
                    totalItems += qty;
                    totalPrice += subtotal;

                    return `
                        <div class="flex items-center justify-between gap-3 p-3.5 rounded-2xl bg-cream-50 border border-amber-100">
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">${item.icon}</span>
                                <div>
                                    <h4 class="font-bold text-sm text-stone-900">${item.name}</h4>
                                    <p class="text-xs text-amber-700 font-semibold">${formatRupiah(item.price)} x ${qty}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="updateQty('${id}', -1)" class="w-7 h-7 rounded-lg bg-white border border-stone-200 text-stone-700 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-minus"></i>
                                </button>
                                <span class="text-sm font-bold w-4 text-center">${qty}</span>
                                <button onclick="updateQty('${id}', 1)" class="w-7 h-7 rounded-lg bg-amber-400 text-amber-950 flex items-center justify-center text-xs font-bold">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Update Badges & Totals
            document.getElementById('cart-badge').textContent = totalItems;
            document.getElementById('floating-count').textContent = totalItems;
            document.getElementById('floating-total').textContent = formatRupiah(totalPrice);
            document.getElementById('modal-total').textContent = formatRupiah(totalPrice);

            const floatingCart = document.getElementById('floating-cart');
            if (totalItems > 0) {
                floatingCart.classList.remove('hidden');
            } else {
                floatingCart.classList.add('hidden');
            }
        }

        // Buka/Tutup Modal Keranjang
        function toggleCart() {
            const modal = document.getElementById('cart-modal');
            modal.classList.toggle('hidden');
        }

        // Kirim Pesanan ke WhatsApp
        function checkoutWhatsApp() {
            const entries = Object.entries(cart);
            if (entries.length === 0) {
                showToast('Pilih minimal 1 varian menu dulu ya!');
                return;
            }

            const customerName = document.getElementById('customer-name').value.trim();
            let totalPrice = 0;
            let orderLines = [];

            entries.forEach(([id, qty], index) => {
                const item = products.find(p => p.id === id);
                const subtotal = item.price * qty;
                totalPrice += subtotal;
                orderLines.push(`${index + 1}. ${item.name} (${qty}x) = ${formatRupiah(subtotal)}`);
            });

            let message = `Halo *Cheesecuit Strato*! Saya mau pesan:\n\n`;
            if (customerName) {
                message += `*Nama:* ${customerName}\n`;
            }
            message += `*Lokasi Ambil:* Universitas Nusa Mandiri (09.00 - 17.00)\n\n`;
            message += `*Daftar Pesanan:*\n${orderLines.join('\n')}\n\n`;
            message += `*Total Bayar: ${formatRupiah(totalPrice)}*\n\nTerima kasih!`;

            const phone = '6287789785482';
            const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
            window.open(waUrl, '_blank', 'noopener,noreferrer');
        }

        // Salin Nomor Telepon
        function copyPhone() {
            const phoneText = '087789785482';
            const tempInput = document.createElement('input');
            tempInput.value = phoneText;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const copyBtnText = document.getElementById('copy-text');
            copyBtnText.textContent = 'Nomor Tersalin!';
            showToast('Nomor 087789785482 berhasil disalin');
            setTimeout(() => {
                copyBtnText.textContent = 'Salin Nomor Telepon';
            }, 2000);
        }

        // Inisialisasi Halaman
        document.addEventListener('DOMContentLoaded', () => {
            renderMenu();
            updateCartUI();
        });
    </script>
</body>
</html>
